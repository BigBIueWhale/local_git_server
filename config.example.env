# Copy to config.env (which git ignores) and fill in. Plain KEY=VALUE lines; it's parsed, not run.

# The stick's USB serial number: `lsblk -do NAME,SERIAL,TRAN,SIZE,MODEL` (the TRAN=usb line).
STICK_SERIAL=REPLACE_WITH_THE_STICKS_SERIAL

# The ext4 file-system UUID. ./format-stick fills it in; for a stick that's already formatted:
# `lsblk -o NAME,FSTYPE,UUID`.
STICK_FS_UUID=filled-in-by-format-stick

# Shown in unit descriptions and comments: letters, digits, spaces and ._()- only.
STICK_NAME="USB stick"
